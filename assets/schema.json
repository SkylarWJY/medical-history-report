{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Patient health-report data (consumed by scripts/build_report.py)",
  "description": "Structured, evidence-based summary of one person's medical records. Every field is OPTIONAL — sections are rendered only when present. NEVER invent values; leave a field out if the records do not support it, and use status words like '需医生确认' for uncertainty.",
  "type": "object",
  "properties": {
    "patient": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "标题（演示时务必使用化名）" },
        "subtitle": { "type": "string" },
        "pills": { "type": "array", "items": { "type": "string" } }
      }
    },
    "overall": {
      "type": "object",
      "properties": {
        "risk_label": { "type": "string" },
        "risk_note": { "type": "string" },
        "stats": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "k": { "type": "string" }, "v": { "type": "string" },
            "color": { "enum": ["green", "yellow", "orange", "red", "blue"] },
            "note": { "type": "string" }
          }
        }},
        "long_existing": { "type": "string" },
        "new_recent": { "type": "string" },
        "top_risk_hint": { "type": "string" }
      }
    },
    "top_issues": { "type": "array", "items": {
      "type": "object",
      "properties": {
        "rank": { "type": "integer" },
        "level": { "enum": ["green", "yellow", "orange", "red"] },
        "title": { "type": "string" }, "why": { "type": "string" },
        "evidence": { "type": "string" }, "advice": { "type": "string" }
      }
    }},
    "evolution": {
      "description": "病情变化史：诊断/分期/状态随时间的演变（一张表）",
      "type": "array", "items": {
        "type": "object",
        "properties": {
          "period": { "type": "string" }, "diagnosis": { "type": "string" },
          "status": { "type": "string" },
          "status_level": { "enum": ["green", "yellow", "orange", "red", "blue"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "lesions": {
      "description": "重点病灶尺寸追踪：每个肿块逐次的精确尺寸。本节是报告的核心价值。",
      "type": "array", "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }, "summary": { "type": "string" }, "note": { "type": "string" },
          "rows": { "type": "array", "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "description": "YYYY-MM" },
              "size": { "type": "string", "description": "原文尺寸 e.g. 4.0x2.9cm / 9x6mm" },
              "extra": { "type": "string", "description": "性质/密度/分级，如 部分实性 / TI-RADS3" },
              "suv": { "type": "string", "description": "PET 的 SUVmax，无则 '—'" },
              "modality": { "type": "string", "description": "CT/MRI/超声/PET-CT" },
              "trend": { "enum": ["up", "down", "flat", "baseline"] }
            }
          }}
        }
      }
    },
    "data_gaps_note": { "type": "string" },
    "data_gaps": {
      "description": "缺什么检查要补：每个部位最近一次标准检查、是否复查、现在该补做什么。回答家属常问的'是没找到报告，还是根本没做这个检查'。",
      "type": "array", "items": {
        "type": "object",
        "properties": {
          "site": { "type": "string" },
          "last_exam": { "type": "string", "description": "最近一次标准检查，含年-月+检查类型" },
          "last_result": { "type": "string" },
          "recheck": { "type": "string", "description": "最近复查了吗，如 '❌ 没复查' / '✅ 较新'" },
          "recheck_level": { "enum": ["green", "yellow", "orange", "red"] },
          "todo": { "type": "string", "description": "现在要补做的检查" }
        }
      }
    },
    "exam_plan_note": { "type": "string" },
    "exam_plan": {
      "description": "每个部位'认准一种检查'+多久查一次。既解释为什么尺寸常对不上（不同设备测），也相当于正常随访/体检该做的检查清单。",
      "type": "array", "items": {
        "type": "object",
        "properties": {
          "site": { "type": "string" },
          "exam": { "type": "string", "description": "认准做哪一种检查（标准方式），如 胸部薄层CT / 甲状腺超声 / 盆腔增强MRI" },
          "freq": { "type": "string", "description": "多久一次" },
          "why": { "type": "string", "description": "为什么用这种、不能用别的" },
          "used_before": { "type": "string", "description": "可选：历年实际用过哪些检查（暴露不一致）" }
        }
      }
    },
    "lab_history_note": { "type": "string" },
    "lab_history": {
      "description": "健康追踪模式：把多次体检/化验的关键指标连成一张趋势表，自动标红当次异常的值，并给出'一直异常/在变差/已正常'的结论。也适用于没生病、想长期管理健康的人。",
      "type": "object",
      "properties": {
        "dates": { "type": "array", "items": { "type": "string" }, "description": "各次检查的日期（列头），如 ['2018','2021','2024-07']" },
        "rows": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" }, "ref": { "type": "string", "description": "参考范围" },
            "values": { "type": "array", "items": { "type": "string" }, "description": "和 dates 一一对应的历次数值" },
            "flags": { "type": "array", "items": { "enum": ["", "high", "low"] }, "description": "和 values 对应：high=偏高标红↑，low=偏低标红↓，空=正常" },
            "verdict": { "type": "string", "description": "趋势结论，如 一直偏高/新近升高/已正常" },
            "verdict_level": { "enum": ["green", "yellow", "orange", "red"] }
          }
        }}
      }
    },
    "recheck_calendar_note": { "type": "string" },
    "recheck_calendar": {
      "description": "该复查日历：每个部位认准的检查 + 下次该做的时间，到点提醒。",
      "type": "array", "items": {
        "type": "object",
        "properties": {
          "exam": { "type": "string" }, "site": { "type": "string" },
          "due": { "type": "string", "description": "下次该做的时间 / 频率" },
          "level": { "enum": ["green", "yellow", "orange", "red"] }
        }
      }
    },
    "lab_trends": {
      "type": "array", "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }, "ref": { "type": "string" }, "note": { "type": "string" },
          "refline_ratio": { "type": "number", "description": "可选 0-1，参考线高度占比" },
          "points": { "type": "array", "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" }, "value": { "type": "number" },
              "level": { "enum": ["green", "yellow", "orange", "red"] }
            }
          }}
        }
      }
    },
    "markers": { "type": "array", "items": {
      "type": "object",
      "properties": { "n": { "type": "string" }, "v": { "type": "string" }, "rg": { "type": "string" } }
    }},
    "systems": { "type": "array", "items": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "level": { "enum": ["green", "yellow", "orange", "red"] },
        "problem": { "type": "string" }, "trend": { "type": "string" }, "advice": { "type": "string" }
      }
    }},
    "timeline": { "type": "array", "items": {
      "type": "object",
      "properties": {
        "year": { "type": "string" }, "major": { "type": "boolean" },
        "events": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "tag": { "enum": ["dx", "tx", "img", "fu", "other"] },
            "text": { "type": "string" }, "where": { "type": "string" }
          }
        }}
      }
    }},
    "changes": {
      "type": "object",
      "properties": {
        "worse": { "type": "array", "items": { "type": "string" } },
        "uncertain": { "type": "array", "items": { "type": "string" } },
        "stable": { "type": "array", "items": { "type": "string" } },
        "better": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk_matrix": { "type": "array", "items": {
      "type": "object",
      "properties": {
        "level": { "enum": ["green", "yellow", "orange", "red"] },
        "system": { "type": "string" }, "note": { "type": "string" }
      }
    }},
    "family_qa": { "type": "array", "items": {
      "type": "object", "properties": { "q": { "type": "string" }, "a": { "type": "string" } }
    }},
    "actions": {
      "type": "object",
      "properties": {
        "now": { "type": "array", "items": { "type": "string" } },
        "m1": { "type": "array", "items": { "type": "string" } },
        "m3": { "type": "array", "items": { "type": "string" } },
        "long": { "type": "array", "items": { "type": "string" } }
      }
    },
    "doctor_questions": { "type": "array", "items": { "type": "string" } },
    "conclusion": { "type": "array", "items": {
      "type": "object",
      "properties": { "k": { "type": "string" }, "v": { "type": "string" }, "big": { "type": "boolean" } }
    }},
    "sources": { "type": "string" }
  }
}
